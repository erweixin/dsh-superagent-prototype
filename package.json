{
  "name": "feishu-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Feishu work assistant powered by Codex CLI",
  "type": "module",
  "files": [
    "lib",
    "dist",
    "prompts",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "SUPERAGENT_DEV=1 tsx watch src/index.ts",
    "start": "node lib/index.js",
    "smoke:codex": "tsx scripts/smoke-codex.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "4.1.8"
  }
}
